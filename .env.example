# Copy to .env and fill in. Everything here is optional — with no .env at all
# the app still starts, seeds the schema, and scrapes its own catalog on first
# run (see README "First run").

# First-run admin user is created when the users table is empty.
# After that, this can be removed (the password is hashed into the DB).
BANDAI30_ADMIN_USER=rei
BANDAI30_ADMIN_PASS=change-me-to-something-long

# Set to 1 to disable application login entirely. ONLY do this when something
# else enforces trust in front of it (Cloudflare Access, a LAN-only bind, a
# VPN). With this on, anyone who reaches the port has full read/write access.
#BANDAI30_NO_AUTH=

# How often to re-scrape for newly announced items. Needs a duration >= 1m.
# LEAVE UNSET AND NOTHING IS EVER REFRESHED AUTOMATICALLY — the first-run
# scrape still happens, but the catalog then goes stale until you refresh a
# line by hand from the UI.
BANDAI30_SCRAPE_INTERVAL=24h

# ntfy.sh topic for a push notification when a scrape finds new items.
# Pick an unguessable one: anyone who knows the topic can read it.
#BANDAI30_NTFY_TOPIC=
#BANDAI30_NTFY_SERVER=https://ntfy.sh

# Host directory holding bandai30.db + photos/, bind-mounted to /data.
# Defaults to ./data. MUST be absolute if you run compose from another
# directory (e.g. a CI checkout), or you'll mount an empty dir and the app
# will start on a blank database.
#BANDAI30_DATA_DIR=/absolute/path/to/bandai30/data
